# Copy to .env and fill in. Placeholders only; never commit real values.

# Compose (database container)
POSTGRES_USER=billing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billing

# api, worker, tests run outside Docker (host port 5433)
DATABASE_URL=postgresql://billing:change-me@localhost:5433/billing

# Stripe test mode only (sk_test_ / rk_test_ keys are accepted)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me

# Checkout redirects
APP_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO

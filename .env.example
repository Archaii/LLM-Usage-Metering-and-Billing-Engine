# Copy to .env and fill in. Placeholders only; never commit real values.

# Compose (database container)
POSTGRES_USER=billing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billing

# api, worker, tests run outside Docker (host port 5433)
DATABASE_URL=postgresql://billing:change-me@localhost:5433/billing

# PayMongo test mode only (the app refuses keys that do not start with sk_test_)
PAYMONGO_SECRET_KEY=sk_test_replace_me
# Signing secret printed by: python -m scripts.register_webhook https://<tunnel-host>/webhooks/paymongo
PAYMONGO_WEBHOOK_SECRET=whsk_replace_me

# Public base URL (your HTTPS tunnel) used for checkout success/cancel redirects
APP_BASE_URL=http://localhost:8000

# Optional: max age of a webhook timestamp in seconds (default 300, 0 disables the check)
# WEBHOOK_TOLERANCE_SECONDS=300

LOG_LEVEL=INFO
